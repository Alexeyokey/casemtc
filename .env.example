# Published port for the local Docker demo.
APP_PORT=8080
# Set this path inside the container only when mounting the organizer archive.
# ENERGYTOOL_KB_PATH=/input/knowledge-base.zip

# Platform supplies these values. No personal paid API key is required.
# No default generation model: use the identifier supplied by organizers.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Aliases: OPENAI_BASE_URL, OPENAI_API_KEY, OPENAI_MODEL / GEN_MODEL.
# BASE_URL is a final legacy fallback from the organizer sample.

# Optional models/keys from the organizer sample, same proxy by default.
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=qwen/qwen3-reranker-8b
EMBEDDER_API_KEY=
RERANKER_API_KEY=
TEMPERATURE=0.0
MAX_TOKENS=2048
RERANKER_TOP_N=2
MAX_WORKERS=3
TOP_K=5

# Client policy, not organizer quotas. Whole call includes queue/retries/body.
API_REQUEST_TIMEOUT_S=30
API_CALL_TIMEOUT_S=60
API_RUN_BUDGET_S=1100
API_MAX_RETRIES=2
API_RETRY_BACKOFF_S=0.5
API_MAX_BATCH_SIZE=32
API_MAX_RESPONSE_BYTES=8388608
