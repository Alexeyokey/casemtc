# Публичная конфигурация веб-чата. Всё, что начинается с VITE_, попадает в браузерный
# бандл, поэтому здесь не может быть секретов: ключи LLM живут только на backend.

# Базовый адрес API. Пусто — тот же origin, что и страница (режим Docker / FastAPI).
VITE_API_BASE_URL=
# mock — синтетические фикстуры без backend; http — настоящий API.
VITE_API_MODE=http
# Показывать переключатель отладки (источники, статусы, время). Можно включить и через ?debug=1.
VITE_DEBUG_TOGGLE=true
# Только для `npm run dev`: куда проксировать /api.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
